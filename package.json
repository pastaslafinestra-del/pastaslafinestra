{
  "name": "lafinestra",
  "version": "2.0.0",
  "description": "Menú digital interactivo, reservas y pedidos por WhatsApp para La Finestra (Ristorante e Pastificio Italiano)",
  "type": "module",
  "scripts": {
    "quality-gate": "node scripts/quality_gate.js",
    "test": "node scripts/quality_gate.js",
    "prerender": "node scripts/prerender.js",
    "start": "npx serve .",
    "db:migrate": "node scripts/db_migrate.js --all",
    "db:dry-run": "node scripts/db_migrate.js --all --dry-run",
    "db:status": "node scripts/db_migrate.js --status",
    "db:seed": "node scripts/db_migrate.js --file docs/database/migrations/002_initial_seed_v2.0.2.sql",
    "test:rls": "node scripts/run_rls_tests.js",
    "auth:create-admin": "node scripts/create_admin.js"
  },
  "keywords": [
    "lafinestra",
    "gastronomy",
    "restaurant",
    "whatsapp-ordering",
    "italian-food",
    "local-first",
    "vanilla-js"
  ],
