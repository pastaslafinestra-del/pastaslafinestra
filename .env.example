# =============================================================================
# LA FINESTRA — VARIABLES DE ENTORNO DE DESARROLLO Y MIGRACIONES
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo a `.env`: cp .env.example .env
# 2. Configura al menos UNO de los métodos de transporte (Método A o B).
# 3. NUNCA subas el archivo `.env` a Git ni compartas tus contraseñas/tokens.
# =============================================================================

# -----------------------------------------------------------------------------
# IDENTIFICADOR DEL PROYECTO SUPABASE
# -----------------------------------------------------------------------------
# Reemplaza con el Project Ref de tu proyecto Supabase (Dashboard -> Settings -> General)
SUPABASE_PROJECT_REF=your_project_ref_here

# -----------------------------------------------------------------------------
# MÉTODO A: SUPABASE MANAGEMENT API (RECOMENDADO / CERO DEPENDENCIAS)
# -----------------------------------------------------------------------------
# Genera tu Personal Access Token (PAT) en:
# https://supabase.com/dashboard/account/tokens
# Permite ejecutar migraciones y DDL vía HTTPS sin requerir abrir puertos TCP :5432 / :6543.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# MÉTODO B: CONEXIÓN DIRECTA POSTGRESQL POOLER (OPCIONAL)
# -----------------------------------------------------------------------------
# Connection string obtenida en: Dashboard -> Project Settings -> Database -> Connection string
# Nota: Si usas pg/DATABASE_URL, preferir puerto :5432 (Session Mode) o :6543 (Transaction Mode con xact locks)
DATABASE_URL=postgresql://postgres.your_project_ref_here:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# CONFIGURACIÓN PÚBLICA DEL CLIENTE (FRONTEND / RESERVAS)
# -----------------------------------------------------------------------------
# Estos valores coinciden con los configurados en js/config.js para la app web
SUPABASE_URL=https://your_project_ref_here.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
